# Copy to .env and fill in. Never commit .env.

# sandbox (default) or production. Sandbox and production use different keys,
# RuNames, and refresh tokens.
EBAY_ENV=sandbox

# App ID (Client ID) and Cert ID (Client Secret) from the eBay developer portal.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# RuName (Redirect URL name), not the accept URL itself.
EBAY_RU_NAME=

# Optional if you already have a refresh token. On Render's free plan, paste the
# token shown once after /auth/callback. It is used whenever no token file exists.
EBAY_REFRESH_TOKEN=

# Required to persist a refresh token from /auth/start.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
TOKEN_STORE_PATH=./data/ebay-tokens.enc

# Recommended before the port is reachable by anyone but you.
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# HTTP bind. Use an uncommon port locally.
HOST=0.0.0.0
PORT=8787

# Public origin of this server, no trailing path. Used for display and for
# Host/Origin checks. Example: https://ebay-mcp.example.com
PUBLIC_BASE_URL=

# Optional comma-separated extra hostnames allowed to call this server.
ALLOWED_HOSTS=
ALLOWED_ORIGINS=

# Optional override. When unset, Content-Language follows the marketplace.
EBAY_CONTENT_LANGUAGE=
